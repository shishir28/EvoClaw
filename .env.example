YOUTUBE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
INFERENCE_BACKEND=vllm
LLM_BASE_URL=http://localhost:9000/v1
LLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct

# Optional transcript proxy support. Leave blank to use best-effort direct access.
TRANSCRIPT_PROXY_HTTP_URL=
TRANSCRIPT_PROXY_HTTPS_URL=
TRANSCRIPT_WEBSHARE_USERNAME=
TRANSCRIPT_WEBSHARE_PASSWORD=
TRANSCRIPT_WEBSHARE_LOCATIONS=
TRANSCRIPT_PROXY_RETRIES_WHEN_BLOCKED=10

# Optional outbound proxy support for YouTube API requests. Leave blank for direct access.
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
NO_PROXY=localhost,127.0.0.1,host.docker.internal,10.200.0.1,10.43.0.10
