{
  "timezone": "Australia/Sydney",
  "jobs": [
    {
      "name": "refresh-video-cache",
      "schedule": "30 0 * * *",
      "description": "Refresh the reusable YouTube candidate cache before evolution and digest jobs at 12:30 AM AEST",
      "module": "adas.youtube_fetcher",
      "args": [
        "--days",
        "7",
        "--max-per-query",
        "10",
        "--output",
        "video_cache_w1.json"
      ],
      "required_env": [
        "YOUTUBE_API_KEY"
      ]
    },
    {
      "name": "adas-evolution",
      "schedule": "30 1 * * *",
      "description": "Overnight ADAS loop at 1:30 AM AEST — generate, evaluate, archive, and promote candidate skills",
      "module": "adas.meta_agent",
      "args": [
        "--cache",
        "{PROJECT_ROOT}/adas/test_sets/video_cache_w1.json",
        "--reflect-passes",
        "2",
        "--deploy-best",
        "--cycles",
        "3"
      ],
      "required_env": []
    },
    {
      "name": "morning-digest",
      "schedule": "30 4 * * *",
      "description": "Send top 3 AI+startup video picks to Telegram at 4:30 AM AEST",
      "module": "adas.telegram_digest",
      "args": [
        "--cache",
        "{PROJECT_ROOT}/adas/test_sets/video_cache_w1.json",
        "--send"
      ],
      "required_env": [
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_CHAT_ID"
      ]
    },
    {
      "name": "reaction-capture",
      "schedule": "30 8 * * *",
      "description": "Poll Telegram for reactions on the digest at 8:30 AM AEST and write feedback",
      "module": "adas.telegram_feedback",
      "args": [
        "--delivery-log",
        "{PROJECT_ROOT}/skills/youtube-curator/delivery_log.json",
        "--feedback",
        "{PROJECT_ROOT}/adas/test_sets/feedback.json"
      ],
      "required_env": [
        "TELEGRAM_BOT_TOKEN"
      ]
    }
  ]
}
